{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShellCanvas app manifest v1",
  "description": "Provisional v1. The desktop parser additionally enforces its 16 Mi UTF-16 package resource budget and UTF-16 title and description lengths. The packer checks the icon file's type and 256 KiB size.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "kind", "id", "version", "title", "permissions"],
  "properties": {
    "clientPlatforms": {
      "description": "Allowed ShellCanvas client targets, independent of remote host OS. Omit for no platform restriction.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["windows", "macos", "linux", "android", "ios", "web"]
      }
    },
    "format": {
      "const": 1
    },
    "kind": {
      "const": "app"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$"
    },
    "title": {
      "type": "string",
      "maxLength": 100,
      "pattern": "\\S"
    },
    "description": {
      "description": "One-line summary shown with the title in app listings.",
      "type": "string",
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]*[^\\s\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029][^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]*$"
    },
    "icon": {
      "description": "PNG, JPEG, WebP or SVG file relative to this manifest. Packaging embeds it; square artwork of at least 128 pixels is recommended.",
      "type": "string",
      "maxLength": 240,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(/[a-zA-Z0-9][a-zA-Z0-9._-]*)*\\.(png|jpg|jpeg|webp|svg)$"
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
      }
    },
    "$schema": {
      "type": "string"
    }
  }
}
