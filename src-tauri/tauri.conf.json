{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShellCanvas",
  "version": "0.1.6",
  "identifier": "dev.shellcanvas.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ShellCanvas",
        "width": 1360,
        "height": 900,
        "minWidth": 680,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src shellcanvas-app: http://shellcanvas-app.localhost; base-uri 'self'"
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "ShellCanvas",
    "homepage": "https://shellcanvas.com/",
    "shortDescription": "A graphical desktop for remote and headless systems",
    "longDescription": "ShellCanvas turns remote and headless systems into graphical workspaces with files, terminals, editors and extensible apps.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2QjBGODYwMUUyMjRDQUQKUldTdFRDSWVZUGl3eHUrejlYMlBHL1dzMXo2dHZST2I3RDhpV3JzL0lzeElqNld0ZE1tWVlycFAK",
      "endpoints": [
        "https://github.com/techartdev/ShellCanvas/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
