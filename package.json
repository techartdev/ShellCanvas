{
  "name": "shellcanvas",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "workspaces": [
    "packages/app-sdk"
  ],
  "scripts": {
    "postinstall": "npm run build:sdk",
    "build:sdk": "npm run build --workspace @techartdev/shellcanvas-app-sdk",
    "test:sdk": "npm run build:sdk && npm test --workspace @techartdev/shellcanvas-app-sdk",
    "verify:sdk": "node scripts/verify-sdk.mjs",
    "verify:adapter-sdk": "node scripts/verify-adapter-sdk.mjs",
    "release:check": "node scripts/check-release-version.mjs",
    "release:windows": "npm run tauri -- build --bundles nsis,msi",
    "public:check": "node scripts/check-public-repo.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:sdk && tsc -b && vite build",
    "test": "vitest run",
    "verify": "node scripts/verify.mjs",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "format": "prettier --write src vite.config.ts *.json *.md docs/*.md src-tauri/*.json src-tauri/capabilities/*.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "core-js": "3.50.0",
    "dialog-polyfill": "0.5.6",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
