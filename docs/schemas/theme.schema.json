{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShellCanvas theme format 1",
  "description": "Data-only desktop themes. File size limit: 32768 UTF-8 bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "kind", "id", "version", "name", "variants"],
  "properties": {
    "format": {
      "const": 1
    },
    "kind": {
      "const": "shellcanvas-theme"
    },
    "id": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"
    },
    "version": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-zA-Z0-9.-]+)?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
    },
    "variants": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "light": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "colors": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "base": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "surface": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "raised": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "inset": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "text": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "muted": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "accent": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "onAccent": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "border": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "hover": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "selection": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "danger": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "dangerSoft": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "warning": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "warningSoft": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "success": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "shadow": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "scrim": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "terminal": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "terminalText": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "sky": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "glow": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "far": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "mid": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "near": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                }
              }
            },
            "font": {
              "enum": ["system", "humanist", "serif", "mono"]
            },
            "windowRadius": {
              "type": "integer",
              "minimum": 0,
              "maximum": 24
            },
            "windowHeader": {
              "type": "integer",
              "minimum": 32,
              "maximum": 60
            },
            "dockRadius": {
              "type": "integer",
              "minimum": 0,
              "maximum": 28
            },
            "blur": {
              "type": "integer",
              "minimum": 0,
              "maximum": 40
            },
            "toolbarHeight": {
              "type": "integer",
              "minimum": 36,
              "maximum": 64
            },
            "dockSize": {
              "type": "integer",
              "minimum": 32,
              "maximum": 64
            }
          }
        },
        "dark": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "colors": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "base": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "surface": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "raised": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "inset": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "text": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "muted": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "accent": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "onAccent": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "border": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "hover": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "selection": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "danger": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "dangerSoft": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "warning": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "warningSoft": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "success": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "shadow": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "scrim": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "terminal": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "terminalText": {
                  "type": "string",
                  "pattern": "^#[a-fA-F0-9]{6}$"
                },
                "sky": {
