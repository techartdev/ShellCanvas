                  "pattern": "^#[a-fA-F0-9]{6}$"
                }
              }
            },
            "font": {
              "enum": ["system", "humanist", "serif", "mono"]
            },
            "windowRadius": {
              "type": "integer",
              "minimum": 0,
              "maximum": 24
            },
            "windowHeader": {
              "type": "integer",
              "minimum": 32,
              "maximum": 60
            },
            "dockRadius": {
              "type": "integer",
              "minimum": 0,
              "maximum": 28
            },
            "blur": {
              "type": "integer",
              "minimum": 0,
              "maximum": 40
            },
            "toolbarHeight": {
              "type": "integer",
              "minimum": 36,
              "maximum": 64
            },
            "dockSize": {
              "type": "integer",
              "minimum": 32,
              "maximum": 64
            }
          }
        }
      }
    }
  }
}
