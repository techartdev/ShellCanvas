{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ShellCanvas adapter source",
  "description": "Structural schema. The CLI and native host additionally validate UTF-8 byte limits, semver numbers, reserved names, unique identities, asset paths, entrypoint membership and hashes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "description",
    "platform",
    "entrypoint",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9-]*(\\.[A-Za-z][A-Za-z0-9-]*)*$",
      "minLength": 3,
      "maxLength": 200
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 100,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "platform": {
      "type": "string"
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\\\:\\x00-\\x1f<>\"|?*]+$"
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^\\x00]*$"
      }
    },
    "configuration": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9-]*$",
                "maxLength": 200
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "kind": {
                "const": "text"
              },
              "required": {
                "type": "boolean"
              },
              "default": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9-]*$",
                "maxLength": 200
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "kind": {
                "const": "password"
              },
              "required": {
                "type": "boolean"
              },
              "default": {
                "type": "null"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9-]*$",
                "maxLength": 200
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "kind": {
                "const": "number"
              },
              "required": {
                "type": "boolean"
              },
              "default": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9-]*$",
                "maxLength": 200
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "kind": {
                "const": "boolean"
              },
              "required": {
                "type": "boolean"
              },
              "default": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          }
        ]
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\\\:\\x00-\\x1f<>\"|?*]+$"
          },
          "executable": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
